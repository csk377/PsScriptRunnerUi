<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Script progress"
    Width="620"
    MinWidth="520"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanMinimize"
    ShowInTaskbar="False"
    Background="#F3F6FA"
    FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="16" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Padding" Value="15,7" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingText" Grid.Row="0" FontSize="22" FontWeight="SemiBold" Foreground="#172033" TextWrapping="Wrap" />

        <Border x:Name="OverallPanel" Grid.Row="1" Margin="0,20,0,0" Padding="18" Background="White" BorderBrush="#D9E0E8" BorderThickness="1" CornerRadius="8">
            <StackPanel>
                <TextBlock x:Name="OverallActivity" Text="Waiting for progress" FontSize="15" FontWeight="SemiBold" Foreground="#172033" />
                <TextBox x:Name="OverallStatus" Text="The script is starting." Margin="0,3,0,9" Padding="0" MaxHeight="150" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Foreground="#5E6878" />
                <ProgressBar x:Name="OverallProgress" IsIndeterminate="True" />
            </StackPanel>
        </Border>

        <Border x:Name="ChildPanel" Grid.Row="2" Margin="26,12,0,0" Padding="16" Background="#EAF0FB" BorderBrush="#C6D5EF" BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="ChildActivity" FontWeight="SemiBold" Foreground="#1D3765" />
                <TextBlock x:Name="ChildStatus" Margin="0,3,0,9" Foreground="#4F6180" TextWrapping="Wrap" />
                <ProgressBar x:Name="ChildProgress" />
            </StackPanel>
        </Border>

        <StackPanel x:Name="OutputPanel" Grid.Row="3" Margin="0,16,0,0" Visibility="Collapsed">
            <TextBlock Text="Script output" FontWeight="SemiBold" Foreground="#172033" Margin="0,0,0,6" />
            <TextBox x:Name="OutputText" Height="200" IsReadOnly="True" AcceptsReturn="True"
                     FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" Padding="8"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     Background="White" BorderBrush="#D9E0E8" />
            <TextBlock x:Name="OutputTruncation" Text="Older output removed; showing the latest 65,536 characters."
                       Visibility="Collapsed" Foreground="#705A16" FontSize="11" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,20,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="False" />
            <Button x:Name="CloseButton" Content="Close" IsDefault="True" Visibility="Collapsed" IsEnabled="False" />
        </StackPanel>
    </Grid>
</Window>
